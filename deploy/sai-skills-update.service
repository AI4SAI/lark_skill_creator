[Unit]
Description=Refresh the published SAI user Skill
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/sai-skills/sai-skill-package.pyz update --store /var/lib/sai-skills --require-index
StateDirectory=sai-skills
StateDirectoryMode=0755
UMask=0022
TimeoutStartSec=4min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

